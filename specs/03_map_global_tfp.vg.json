{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 680,
  "height": 360,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F4EFE4"
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#E2DAC6",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/world_110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E4DEC9",
        "stroke": "#FBF8F3",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/global_tfp_binned.csv"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M0,-1 L0.866,-0.5 L0.866,0.5 L0,1 L-0.866,0.5 L-0.866,-0.5 Z",
        "size": 75,
        "stroke": "#FBF8F3",
        "strokeWidth": 0.8,
        "opacity": 0.96
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "TFP_Index_2024",
          "type": "quantitative",
          "scale": {
            "scheme": "viridis",
            "domain": [
              115,
              220
            ]
          },
          "legend": {
            "title": "TFP Index (1990=100)",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "bin_id",
            "type": "nominal",
            "title": "Tessellation Bin ID"
          },
          {
            "field": "TFP_Index_2024",
            "type": "quantitative",
            "title": "2024 TFP Index (1990=100)",
            "format": ".1f"
          },
          {
            "field": "Annual_TFP_Growth_Pct",
            "type": "quantitative",
            "title": "Annual TFP Growth (%)",
            "format": ".2f"
          },
          {
            "field": "OECD_Producer_Support_Pct",
            "type": "quantitative",
            "title": "OECD Producer Subsidy (% Receipts)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Lon": 118,
            "Lat": -44,
            "Label": "Australia: 164.2 TFP Index with only 2.4% OECD subsidy"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 0,
        "fontSize": 11.5,
        "fontWeight": "bold",
        "fill": "#C85A32"
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, sans-serif",
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "axis": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#232725",
      "labelColor": "#454D48",
      "gridColor": "#EAE3D2",
      "domainColor": "#C7BFA8"
    },
    "legend": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#1E4D3B"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
